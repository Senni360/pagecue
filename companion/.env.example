OPENAI_API_KEY=your-key-here
PAGECUE_MODEL=gpt-4o-mini
PAGECUE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Answer provider: openai, openrouter, or opencode
PAGECUE_PROVIDER=openai
OPENROUTER_API_KEY=
PAGECUE_OPENROUTER_MODEL=
OPENCODE_API_KEY=
# OPENCODE_ZEN_API_KEY is also recognized
PAGECUE_OPENCODE_MODEL=gpt-5.4-mini
PAGECUE_OPENCODE_FORMAT=responses

# Audio-to-text provider: openai or openrouter
PAGECUE_AUDIO_PROVIDER=openai
PAGECUE_OPENROUTER_AUDIO_MODEL=openai/whisper-1
